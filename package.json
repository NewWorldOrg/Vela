{
  "name": "vela",
  "version": "0.3.7",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && yarn run prettier:check",
    "prettier": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "prettier:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import ./scripts/test-alias.mjs --test \"tests/**/*.test.ts\"",
    "codegen": "openapi-typescript repository/client/carina.json -o repository/client/schema.ts && prettier --write repository/client/schema.ts",
    "codegen:verify": "node scripts/codegen-verify.mjs",
    "bml-runtime": "node scripts/bml-runtime.mjs",
    "codegen:fetch": "node --input-type=module -e \"const base = process.env.CARINA_API_BASE_URL; if (!base) { throw new Error('CARINA_API_BASE_URL is not set') } const response = await fetch(new URL('/openapi/v1.json', base)); if (!response.ok) { throw new Error(response.status + ' from ' + base) } const { writeFile } = await import('node:fs/promises'); await writeFile('repository/client/carina.json', await response.text())\" && yarn codegen",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --maxWorkers=25%",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"http-server storybook-static --port 6006 --silent --cors\" \"wait-on http://127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --maxWorkers=2 --shard=${STORYBOOK_SHARD:-1/1}\""
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/nextjs": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "http-server": "^14",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  },
  "resolutions": {
    "uuid": "^14.0.0",
    "webpack-dev-middleware": "^8.0.0",
    "jest-runtime": "30.5.2"
  }
}
