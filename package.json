{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && yarn run prettier:check",
    "prettier": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "prettier:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import ./scripts/test-alias.mjs --test \"tests/**/*.test.ts\"",
    "codegen": "openapi-typescript repository/client/carina.json -o repository/client/schema.ts && prettier --write repository/client/schema.ts",
    "codegen:verify": "node scripts/codegen-verify.mjs",
    "bml-runtime": "node scripts/bml-runtime.mjs",
    "codegen:fetch": "node --input-type=module -e \"const base = process.env.CARINA_API_BASE_URL; if (!base) { throw new Error('CARINA_API_BASE_URL is not set') } const response = await fetch(new URL('/openapi/v1.json', base)); if (!response.ok) { throw new Error(response.status + ' from ' + base) } const { writeFile } = await import('node:fs/promises'); await writeFile('repository/client/carina.json', await response.text())\" && yarn codegen",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --maxWorkers=25%",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"http-server storybook-static --port 6006 --silent\" \"wait-on http://127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --maxWorkers=2 --shard=${STORYBOOK_SHARD:-1/1}\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.10",
    "openapi-fetch": "^0.17.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10",
    "@storybook/nextjs": "^10",
    "@storybook/react": "^10",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@xmldom/xmldom": "^0.9.12",
    "concurrently": "^9",
    "esbuild": "0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.10",
    "http-server": "^14",
    "openapi-typescript": "^7",
    "postcss": "^8.5.15",
    "storybook": "^10",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "wait-on": "^9"
  }
}
